# Configuração SMTP — copie para `.env.development` e preencha.
# Usado por Backend/config/EmailConnection.py (host, porta e timeout).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_TIMEOUT=10

# Credenciais (deixe vazio em servidor local sem autenticação).
SMTP_USER=
SMTP_PASSWORD=

# Raiz local dos documentos recebidos (padrão: Backend/arquivos/recebidos)
FOLHA_STORAGE_DIR=
